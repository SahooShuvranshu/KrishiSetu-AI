# KrishiSetu AI - Environment Variables
# Copy this file to .env and fill in your API keys

# ============================================================
# Gemini API (Already configured)
# ============================================================
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# ============================================================
# Google Maps Platform (NEW - Required for hackathon)
# ============================================================
# Get from: https://console.cloud.google.com/apis/credentials
# Enable: Maps JavaScript API
VITE_GOOGLE_MAPS_KEY=your_google_maps_api_key_here

# ============================================================
# Firebase (NEW - Required for hackathon)
# ============================================================
# Get from: https://console.firebase.google.com
# Create project > Add web app > Copy config
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# ============================================================
# Google Cloud (For Vertex AI training)
# ============================================================
# Not needed in .env - use service account in Colab
# See notebooks/KrishiSetu_Real_Model_Training.ipynb
